# Shared IDF configuration for the native-BLE gateway example.
# Target-agnostic on purpose: the same file serves the ESP32,
# ESP32-S3 and ESP32-C3 environments.

# Arduino-as-IDF-component knob — without it the Arduino runtime is
# never started and setup()/loop() never run.
CONFIG_AUTOSTART_ARDUINO=y

# Flash size and partition table. 4 MB is what every one of the three
# targets has at minimum, so one layout serves all of them: two OTA app
# slots of 1.875 MB each, a small SPIFFS and a coredump partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4mb.csv"

# Optimize for size. The IDF default is -Og, which leaves the firmware
# barely inside a 1.9 MB OTA slot once Bluedroid, WiFi and TLS are in.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Match SensESP's own [espidf] settings so its assumptions hold.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Bluetooth host: Bluedroid in BLE-central mode. GATTC is the client
# role NativeBLE exposes; the gateway never acts as a peripheral, so
# the server role and BLE Mesh stay off to save RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BLE_MESH=n

# BLE 4.2 legacy scan/advertising APIs. NativeBLE uses
# esp_ble_gap_set_scan_params(), which belongs to that feature set.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

CONFIG_BT_BTU_TASK_STACK_SIZE=8192

# 3 concurrent GATT connections plus one link reserved for scanning.
CONFIG_BT_ACL_CONNECTIONS=4

# Bluedroid plus WiFi overflows the classic ESP32's IRAM. Keeping the
# WiFi fast paths in flash instead frees enough of it to link. The cost
# is a little WiFi throughput, which a BLE gateway never approaches.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# WiFi and BLE share one radio on all three targets.
CONFIG_SW_COEXIST_ENABLE=y

# Misc — match SensESP's top-level [espidf] env.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# ---------------------------------------------------------------------
# TLS record buffers. Measured on this target (ESP32, no PSRAM) against a
# Traefik TLS entrypoint; see "A note on memory" in the README.
# ---------------------------------------------------------------------

# With dynamic buffers on, esp_ssl_tls.c wraps
# mbedtls_ssl_write/read so the TLS record buffer is allocated per call and
# freed again, and once the heap has no ~4.4 kB contiguous block a POST fails
# with ESP_ERR_HTTP_WRITE_DATA on a connection that is still open. Off is the
# IDF default; pinned because nothing else holds it and the failure is silent.
#
# The cost is that every open session keeps its buffers for its lifetime:
# about 16.4 kB in and 4.1 kB out. This gateway opens three — the POST client,
# the control WebSocket and SKWSClient's delta socket — which on a board without
# PSRAM would be roughly 60 kB of internal RAM committed to TLS, and is why a
# plain ESP32 establishes only the first of them. Turning the option on to
# reclaim that is what reintroduces the failure.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n

# TLS input record size, build-wide: it has to hold for every session the
# firmware opens, not only the gateway's two. Nothing else can shrink the
# buffer. CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH is off, so the allocation is
# this size whatever the peer negotiates, and nothing here negotiates: mbedTLS
# compiles RFC 6066 max_fragment_length in but esp-tls never calls
# mbedtls_ssl_conf_max_frag_len, and RFC 8449 record_size_limit, which replaces
# it, is not compiled in at all.
#
# Two things arrive in the buffer. The handshake, whose largest message is the
# server's certificate chain, and application data. Neither gateway channel
# carries much of the latter: the advertisement POST is answered with a short
# JSON object, and the control WebSocket receives only hello_ack,
# gatt_subscribe, gatt_write and gatt_close, the largest of them an ATT payload
# in hex. What binds the setting is SensESP's Signal K delta socket, which
# shares it and reads whatever the server chooses to send.
#
# 8192 holds both the chain and the delta stream — production SensESP devices
# run it against the same server — and it still bought nothing here. Only the
# first of the three sessions establishes, at either size, and at 8192 the
# failure lands later and harder: the websocket task is created,
# mbedtls_ssl_setup then returns ALLOC_FAILED and the device reboots, where at
# 16384 the task allocation fails first and the gateway stays up. Free heap came
# out within 2% and the largest free block stayed in the same 2-3 kB band.
#
# 4096 was not measured. Earlier SensESP testing settled 8192 as the smallest
# value the delta stream tolerates, and 8192 bought nothing here, so a smaller
# one has nothing left to offer. Revisit when the session count drops; see
# issues 22 and 27.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
